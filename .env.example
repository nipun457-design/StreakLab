# StreakLab — Environment Configuration Template (Phase 4)
# Copy this file to .env to configure optional AI-assisted pattern explanations.
# The application functions completely offline with local fallback if no key is provided.

# AI Provider: 'gemini', 'openai', or leave blank for offline local fallback
AI_PROVIDER=gemini

# Your API Key (Never commit the actual .env file with secrets)
AI_API_KEY=your_api_key_here

# Model Identifier (e.g., 'gemini-1.5-flash', 'gemini-2.0-flash', or 'gpt-4o-mini')
AI_MODEL=gemini-1.5-flash

# Optional: Custom API Base URL or Proxy Endpoint
# AI_ENDPOINT=https://custom-proxy.example.com/v1

# Request Timeout in seconds (default: 6, min: 2, max: 30)
AI_TIMEOUT=6

# --- Production Database (PostgreSQL) ---
# Set when deploying to Vercel with Neon, Supabase, or Vercel Postgres
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# --- Web Push (VAPID) Credentials ---
# Generate using: python -c "import push_service; print(push_service.generate_vapid_keypair())"
# VAPID_PUBLIC_KEY=your_vapid_public_key_here
# VAPID_PRIVATE_KEY=your_vapid_private_key_here
# VAPID_CLAIM_EMAIL=mailto:your-email@example.com

# --- Scheduled Reminder Cron Secret ---
# Shared secret protecting GET/POST /api/cron/reminders
# CRON_SECRET=your_secure_random_cron_secret_here
