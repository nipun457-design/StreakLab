# StreakLab — Environment Configuration Template (Phase 4)
# Copy this file to .env to configure optional AI-assisted pattern explanations.
# The application functions completely offline with local fallback if no key is provided.

# AI Provider: 'gemini', 'openai', or leave blank for offline local fallback
AI_PROVIDER=gemini

# Your API Key (Never commit the actual .env file with secrets)
AI_API_KEY=your_api_key_here

# Model Identifier (e.g., 'gemini-1.5-flash', 'gemini-2.0-flash', or 'gpt-4o-mini')
AI_MODEL=gemini-1.5-flash

# Optional: Custom API Base URL or Proxy Endpoint
# AI_ENDPOINT=https://custom-proxy.example.com/v1

# Request Timeout in seconds (default: 6, min: 2, max: 30)
AI_TIMEOUT=6
